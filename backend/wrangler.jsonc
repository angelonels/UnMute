{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "unmute-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-12",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
  },
  "vars": {
    "ENVIRONMENT": "development",
    "FRONTEND_ORIGIN": "http://localhost:5173",
  },
  "dev": {
    "port": 8787,
    "local_protocol": "http",
  },
}
