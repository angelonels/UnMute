    "@tanstack/react-router": "^1.170.35",
    "@unmute/shared": "workspace:*",
    "motion": "^13.2.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sonner": "^2.0.8",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@astryxdesign/cli": "^0.6.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
